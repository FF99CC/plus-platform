# python3 dev.py prepare 会自动生成完整的 .env.local，不需要手填下面的密码。
# .env.local 是唯一需要调整的本地配置；不使用 export、引号或变量插值。
WEB_PORT=18880
CAPTCHA_ENABLED=true
# 基础设施密码：20–64 位字母、数字、下划线或短横线。
DB_ROOT_PASSWORD=AUTO_GENERATED
DB_PASSWORD=AUTO_GENERATED
REDIS_PASSWORD=AUTO_GENERATED
JWT_SECRET=AUTO_GENERATED
# 登录密码：8–20 位；默认仍随机生成 20 位。首次启动后不要直接修改这些项。
ADMIN_PASSWORD=AUTO_GENERATED
TEST_PASSWORD=AUTO_GENERATED
TEST1_PASSWORD=AUTO_GENERATED
# 可选 DEMO_PASSWORD：仅首次创建演示账号时使用，省略则随机生成。
# 已有演示账号保持原密码，修改此项不会重置账号。
